{
  "name": "leet-forces",
  "displayName": "Leet-Forces (LeetCode + Codeforces)",
  "description": "Solve LeetCode and Codeforces problems without leaving VS Code: fetch, test, submit.",
  "version": "0.1.5",
  "publisher": "Spy48",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tabish-5/LeetForcesVSC.git"
  },
  "categories": [
    "Other"
  ],
  "icon": "./media/icon.ico",
  "keywords": [
    "leetcode",
    "java",
    "algorithms",
    "cp",
    "competetive programing",
    "code forces",
    "practice"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leetforces",
          "title": "Leet-Forces",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "leetforces": [
        {
          "type": "webview",
          "id": "leetforces.sidebar",
          "name": "Problem",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "leetforces.test",
        "title": "Test",
        "category": "Leet-Forces",
        "icon": "$(play)"
      },
      {
        "command": "leetforces.submit",
        "title": "Submit",
        "category": "Leet-Forces",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "leetforces.description",
        "title": "Show Description",
        "category": "Leet-Forces",
        "icon": "$(book)"
      },
      {
        "command": "leetforces.changeProblem",
        "title": "Change Problem",
        "category": "Leet-Forces"
      },
      {
        "command": "leetforces.nextProblem",
        "title": "Next Problem",
        "category": "Leet-Forces"
      },
      {
        "command": "leetforces.prevProblem",
        "title": "Previous Problem",
        "category": "Leet-Forces"
      },
      {
        "command": "leetforces.dailyProblem",
        "title": "LeetCode Daily Problem",
        "category": "Leet-Forces"
      },
      {
        "command": "leetforces.openSolution",
        "title": "Open Solution File",
        "category": "Leet-Forces"
      },
      {
        "command": "leetforces.savedTests",
        "title": "Failed Cases / Custom Tests",
        "category": "Leet-Forces"
      },
      {
        "command": "leetforces.chooseLanguage",
        "title": "Choose Language",
        "category": "Leet-Forces"
      },
      {
        "command": "leetforces.switchPlatform",
        "title": "Switch Platform (LeetCode / Codeforces)",
        "category": "Leet-Forces"
      },
      {
        "command": "leetforces.account",
        "title": "Log in / Account",
        "category": "Leet-Forces"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "leetforces.test",
          "when": "resourceFilename =~ /^(lc_solution\\.|solution\\.|Main\\.)/",
          "group": "navigation@1"
        },
        {
          "command": "leetforces.submit",
          "when": "resourceFilename =~ /^(lc_solution\\.|solution\\.|Main\\.)/",
          "group": "navigation@2"
        },
        {
          "command": "leetforces.description",
          "when": "resourceFilename =~ /^(lc_solution\\.|solution\\.|Main\\.)/",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Leet-Forces",
      "properties": {
        "leetforces.language": {
          "type": "string",
          "default": "cpp",
          "enum": [
            "cpp",
            "c",
            "java",
            "python",
            "javascript",
            "kotlin",
            "go",
            "rust",
            "csharp",
            "ruby",
            "php",
            "scala"
          ],
          "description": "Language used for both LeetCode and Codeforces."
        },
        "leetforces.codeforces.submitMode": {
          "type": "string",
          "default": "browser",
          "enum": [
            "browser",
            "direct",
            "ask"
          ],
          "enumDescriptions": [
            "Copy code to clipboard, open the submit page, you pass the human check and click Submit; the verdict is tracked here.",
            "Post the form straight from VS Code (needs a valid browser cookie; may be blocked by Cloudflare).",
            "Ask every time."
          ],
          "description": "How to submit to Codeforces."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Leet-Forces compiles and runs code and reads state files from the workspace; only use it in folders you trust."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository",
    "dev": "vsce package"
  },
  "dependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}